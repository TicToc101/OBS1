views:
  - type: table
    name: Table
  - type: table
    name: Clipping notes
    filters:
      and:
        - file.hasTag("clippings")
    order:
      - file.name
      - file.folder
      - author
      - created
      - Source
  - type: table
    name: Dail Notes
    filters:
      and:
        - file.hasTag("DailyNotes", "Daily")
    order:
      - file.name
      - file.basename
    sort: []
